{
  "name": "video-downloader",
  "version": "0.1.0",
  "description": "A local desktop video downloader powered by yt-dlp and ffmpeg.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
